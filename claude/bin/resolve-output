#!/usr/bin/env bash
set -euo pipefail

DEFAULT_OUTPUT_DIR="$HOME/Documents/Shortcuts Playground"
DEFAULT_SIGNING_MODE="anyone"
CONFIGURED_OUTPUT_DIR=""
CONFIGURED_SIGNING_MODE=""

usage() {
  printf 'Usage: resolve-output [--output-dir DIR] [--mode anyone|people-who-know-me]\n' >&2
  exit 64
}

unset_if_placeholder() {
  case "$1" in
    '${user_config.'*) printf '' ;;
    *) printf '%s' "$1" ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    --output-dir)
      [ $# -ge 2 ] || usage
      CONFIGURED_OUTPUT_DIR="$(unset_if_placeholder "$2")"
      shift 2
      ;;
    --mode)
      [ $# -ge 2 ] || usage
      CONFIGURED_SIGNING_MODE="$(unset_if_placeholder "$2")"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

OUTPUT_DIR="${CONFIGURED_OUTPUT_DIR:-${CLAUDE_PLUGIN_OPTION_OUTPUT_DIR:-$DEFAULT_OUTPUT_DIR}}"
case "$OUTPUT_DIR" in
  "~") OUTPUT_DIR="$HOME" ;;
  \~/*) OUTPUT_DIR="$HOME/${OUTPUT_DIR#\~/}" ;;
  '$HOME') OUTPUT_DIR="$HOME" ;;
  '$HOME/'*) OUTPUT_DIR="$HOME/${OUTPUT_DIR#\$HOME/}" ;;
esac
SIGNING_MODE="${CONFIGURED_SIGNING_MODE:-${CLAUDE_PLUGIN_OPTION_SIGNING_MODE:-$DEFAULT_SIGNING_MODE}}"

mkdir -p "$OUTPUT_DIR/drafts"
printf 'OUTPUT_DIR=%s\n' "$OUTPUT_DIR"
printf 'SIGNING_MODE=%s\n' "$SIGNING_MODE"
